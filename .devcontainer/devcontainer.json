{
  "name": "Kanban Markdown",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code",
        "LachyFS.kanban-markdown"
      ]
    }
  },
  "remoteUser": "node",
  "mounts": [
    // Keeps the Claude Code login and settings across rebuilds.
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    // The host's node_modules holds binaries for the host platform.
    "source=node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
