{
  "model": "opusplan",
  "advisorModel": "opus",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "sandbox": {
    "excludedCommands": [
      "pnpm run build:extension",
      "env -u ELECTRON_RUN_AS_NODE xvfb-run -a pnpm run test:integration"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|clear|startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-watch.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}